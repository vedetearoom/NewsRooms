# Backend app settings loaded inside the container from /run/config/backend.env
# Most deployments only need to edit:
# 1. DATABASE_URL / DATABASE_URL_SYNC / REDIS_URL
# 2. AUTH_SECRET_KEY
# 3. CREDENTIAL_ENCRYPTION_SECRET
# 4. Optional: Clerk settings for hosted auth / webhook sync
# 5. Optional: JINA_API_KEY
#
# Usually NOT required here:
# - GEMINI_API_KEY / QWEN_API_KEY
#   In this project, those are commonly configured per-agent in the UI.
#   These env vars are only global fallback values.

DATABASE_URL=postgresql+asyncpg://postgres:metalm2024@metalm-base-pg:5432/metalm
DATABASE_URL_SYNC=postgresql+psycopg://postgres:metalm2024@metalm-base-pg:5432/metalm
REDIS_URL=redis://:metalm2024@metalm-base-redis:6379/0

# Optional global fallback for Gemini models.
# Leave empty if you configure each agent's API key in the UI.
GEMINI_API_KEY=

# Optional.
# Used by Jina Reader for cleaner webpage-to-Markdown extraction.
# If empty, the app falls back to basic HTML extraction.
JINA_API_KEY=

# Optional global fallback for Qwen / DashScope models.
# Leave empty if you configure each agent's API key in the UI.
QWEN_API_KEY=

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
SCRAPE_CRON=0 */4 * * *

MINIO_ENDPOINT=http://metalm-base-minio-sse:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=newsroom-images

RSSHUB_BASE_URL=http://metalm-rsshub:1200
DOCKER_COMPOSE_DIR=/opt/infra/docker

# Recommended.
# Used to encrypt platform cookies stored in the database for monitor integrations.
# Must stay stable after deployment, otherwise old saved cookies can no longer be decrypted.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_SECRET=

# Recommended and should always be changed in real environments.
# Used for auth-related signing / security logic.
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=ai-newsroom-dev-secret

# Optional Clerk integration.
# CLERK_ISSUER should look like: https://your-instance.clerk.accounts.dev
# CLERK_SECRET_KEY is the Clerk Backend API secret key.
# CLERK_WEBHOOK_SECRET is the Svix signing secret from Clerk Webhooks.
# CLERK_ADMIN_EMAILS is a comma-separated allowlist that receives the super_admin role on sync/login.
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ADMIN_EMAILS=

# Optional bootstrap admin account for first startup.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@newsroom.local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_DISPLAY_NAME=Administrator
