# Compose / image names
AI_NEWSROOM_BACKEND_IMAGE=ai-newsroom-backend:local
AI_NEWSROOM_FRONTEND_IMAGE=ai-newsroom-frontend:local
AI_NEWSROOM_HERMES_SANDBOX_LIGHT_IMAGE=ai-newsroom-hermes-sandbox-light:local

# Build mirrors
AI_NEWSROOM_NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
AI_NEWSROOM_PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.13-slim
AI_NEWSROOM_NPM_REGISTRY=https://registry.npmmirror.com
AI_NEWSROOM_APT_MIRROR_HOST=mirrors.aliyun.com
AI_NEWSROOM_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
AI_NEWSROOM_PIP_TRUSTED_HOST=mirrors.aliyun.com
AI_NEWSROOM_PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000
AI_NEWSROOM_PLAYWRIGHT_DOWNLOAD_HOST=

# App ports
AI_NEWSROOM_HTTP_PORT=8080
AI_NEWSROOM_BACKEND_PORT=8000
AI_NEWSROOM_FRONTEND_PORT=3000
# Recommended for 4C/8G: total Celery concurrency 4, keep full video analysis at 1.
AI_NEWSROOM_CELERY_FAST_CONCURRENCY=2
AI_NEWSROOM_CELERY_AI_CONCURRENCY=1
AI_NEWSROOM_CELERY_VIDEO_CONCURRENCY=1

# Frontend / network
AI_NEWSROOM_INTERNAL_API_URL=http://backend:8000
AI_NEWSROOM_INTERNAL_ASSET_URL=http://backend:8000
AI_NEWSROOM_PUBLIC_API_URL=
AI_NEWSROOM_PUBLIC_MINIO_BUCKET=newsroom-images
AI_NEWSROOM_INFRA_NETWORK=metalm-base-net
AI_NEWSROOM_TENANT_ROOT_HOST=../../ai-newsroom/.tenant-data

# Clerk frontend settings
# Required when Clerk auth is enabled in production.
AI_NEWSROOM_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
AI_NEWSROOM_CLERK_SECRET_KEY=
AI_NEWSROOM_NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
AI_NEWSROOM_NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
AI_NEWSROOM_NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/
AI_NEWSROOM_NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/
